{
  "routes": [
    {
      "route": "/api/upload",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/upload-session",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/manifest.json",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "content-type": "application/manifest+json"
      }
    },
    {
      "route": "/envirocheck_checklists.json",
      "headers": {
        "Cache-Control": "public, no-cache"
      }
    },
    {
      "route": "/nps_locations.json",
      "headers": {
        "Cache-Control": "public, no-cache"
      }
    },
    {
      "route": "/vendor/jszip.min.js",
      "rewrite": "/vendor/jszip-3.10.1.min.js"
    },
    {
      "route": "/vendor/exceljs.min.js",
      "rewrite": "/vendor/exceljs-4.4.0.min.js"
    },
    {
      "route": "/vendor/docx.umd.js",
      "rewrite": "/vendor/docx-8.2.2.umd.js"
    },
    {
      "route": "/vendor/*.js",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/sw.js",
      "/*.json",
      "/vendor/*",
      "/*.{png,jpg,ico,svg,webp}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "responseOverrides": {
    "401": {
      "statusCode": 401
    }
  }
}
